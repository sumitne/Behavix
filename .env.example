# Copy to .env and adjust: cp .env.example .env

# Server
PORT=8080

# Database (used to build connection; POSTGRES_DSN overrides if set)
# On macOS/Homebrew Postgres, the default role is often your system username, not "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=behavix
DB_SSLMODE=disable
